# Exemple de configuration. Copier vers .env — ne jamais versionner le vrai fichier.
NODE_ENV=development
PORT=3000

# Base PostgreSQL 13+ (obligatoire)
DATABASE_URL=postgresql://user:password@localhost:5432/school_manager_pro
# true si la base impose TLS (hébergeur géré)
DATABASE_SSL=false

# OBLIGATOIRE en production : 32 caractères minimum, aléatoire.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origines autorisées (CORS), séparées par des virgules. Vide = même origine uniquement.
CORS_ORIGINS=
# true si l'application est derrière un proxy inverse (nginx, Render, etc.)
TRUST_PROXY=false

# Limitation de débit
RATE_LIMIT_API_PER_MINUTE=600
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Scripts : mot de passe de l'admin de démonstration (sinon généré et affiché une fois)
# SEED_ADMIN_PASSWORD=
# Tests d'intégration : base DÉDIÉE dont le nom finit par _test (son schéma est effacé !)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/school_manager_pro_test

# --- E-mails (facture, rappels, mot de passe oublié). Sans SMTP_HOST : envoi désactivé, l'application fonctionne normalement.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true pour le port 465 (TLS implicite) ; sinon STARTTLS est utilisé s'il est proposé
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Adresse d'expédition (obligatoire pour activer l'envoi)
# MAIL_FROM="School Manager Pro <noreply@votre-domaine.ml>"
# Adresse publique de l'application (liens des e-mails de réinitialisation) — obligatoire pour « mot de passe oublié »
# APP_URL=https://ecole.votre-domaine.ml
# false pour désactiver les rappels automatiques (licences, factures impayées)
# MAIL_SCHEDULER=true

# --- Sauvegarde (npm run backup)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# --- SMS et WhatsApp (notifications aux parents, via Twilio). Sans ces variables : canaux « indisponibles », rien n'est envoyé.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1XXXXXXXXXX
# TWILIO_WHATSAPP_FROM=+14155238886
# DEFAULT_COUNTRY_CODE=223
# NOTIFY_DAILY_LIMIT=500   # plafond de SMS/WhatsApp par établissement et par jour (0 = illimité)

# Documents (ordonnance §4.4) : dossier de stockage PRIVÉ, hors du site public, à sauvegarder avec la base
# DOCUMENTS_DIR=./storage/documents
# DOCUMENT_MAX_MB=10
